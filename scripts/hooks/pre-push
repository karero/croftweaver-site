#!/bin/sh
# Quality gate — blocks a push if the site's tests fail, so a broken build
# never reaches the deploy branch. This is the local enforcement of the
# test-driven contract (CI in .github/workflows/ runs the same checks).
#
# Wired automatically by the "prepare" script in package.json (npm install sets
# core.hooksPath to scripts/hooks). The `check_seo.py` step runs only if that
# file exists, so this same hook works whether SEO is a Python gate or seo.spec.ts.
#
# Relax for ONE push:   git push --no-verify
# Disable entirely:     git config --unset core.hooksPath
#
set -e

# The repository variables git hands a hook (git's own list of them). Pushed from a linked
# worktree, they include GIT_DIR, and a `git -c …` push hands its settings down as well. A step
# that runs git in a scratch repo, or from a subfolder, would then find the wrong repository
# or the wrong top folder. Cleared, git finds the repository from the folder a step runs in.
unset $(git rev-parse --local-env-vars)

# OPTIONAL: PR-only main flow. If this repo's convention is that new commits
# reach main only via reviewed PRs (typical when several people or parallel AI
# agents share the checkout), uncomment the block below to reject direct
# pushes to main. Ship flows pushing main:production are unaffected; GitHub
# PR merges happen server-side, so they're unaffected too. Deliberate exception:
# ALLOW_MAIN_PUSH=1 git push ...
# (Must stay ABOVE the build/test steps: it consumes the hook's stdin.)
#
# while read -r _lref _lsha remote_ref _rsha; do
#   if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
#     echo "✗ Direct push to 'main' blocked — open a PR instead (ALLOW_MAIN_PUSH=1 to override)." >&2
#     exit 1
#   fi
# done

# First, because it needs neither the build nor a browser nor the network: it drives
# scripts/ship.sh against a stubbed git, and against throwaway repos on this computer, and
# checks that a failed publish is diagnosed correctly. Nothing else exercises that script —
# its only other workout is an actual publish, when a wrong message is most expensive.
if [ -f tests/check_ship_push.sh ]; then
  echo "▶ pre-push gate: publish classifier…"
  bash tests/check_ship_push.sh
fi

# Likewise for the script that makes the published AI-check file: it may publish one site only.
if [ -f tests/check_export_ai_check.sh ]; then
  echo "▶ pre-push gate: AI check export…"
  bash tests/check_export_ai_check.sh
fi

# And for the case study's own export: croftweaver.com only, counts only.
if [ -f tests/check_export_own_site.sh ]; then
  echo "▶ pre-push gate: case study export…"
  bash tests/check_export_own_site.sh
fi

# The security.txt file: a contact, the canonical address, and an Expires date that has not run out.
# Warns at 30 days, fails at 7 (see the script), so a lapse also holds up a push and `npm run ship`.
# Needs no build. A warning is printed again after the tests, so that it does not scroll away.
sec_warn=""
if [ -f tests/check_security_txt.sh ]; then
  echo "▶ pre-push gate: security.txt (its self-test takes a few seconds)…"
  if ! sec_out=$(bash tests/check_security_txt.sh 2>&1); then
    printf '%s\n' "$sec_out"
    exit 1
  fi
  printf '%s\n' "$sec_out"
  sec_warn=$(printf '%s\n' "$sec_out" | grep '^ *WARN' || true)
fi

echo "▶ pre-push gate: building…"
npm run build

# Every fact on /security is a claim with a source and a date. Reads the build made just above.
if [ -f tests/check_security_page.sh ]; then
  echo "▶ pre-push gate: security page claims…"
  bash tests/check_security_page.sh
fi

if [ -f tests/check_seo.py ]; then
  echo "▶ pre-push gate: SEO checks…"
  python3 tests/check_seo.py
fi

echo "▶ pre-push gate: tests…"
npm test

if [ -n "$sec_warn" ]; then
  echo "⚠ security.txt is close to its Expires date; renew it soon:"
  printf '%s\n' "$sec_warn"
fi

echo "✓ pre-push gate passed — pushing."
