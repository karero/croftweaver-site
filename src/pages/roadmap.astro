---
// /roadmap — what is missing, what comes next, what stays out. Positioning term
// (tests/positioning.spec.ts): "roadmap", in the title, the description and the H1.
// No delivery dates and no promises (the one date is when the roadmap was last read): the order is the maintainer's current intent
// (owner-approved plan, 2026-10-03) and may change.
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

// Edit both by hand, and only after re-reading this page against that release.
const REVIEWED = { version: '0.32', iso: '2026-10-20', label: '20 October 2026' } as const;

const next = [
  { title: 'Moving your domain to Cloudflare, with your assistant', text: 'Many people who start a site already have a domain. Its DNS records, which point it at a website and at mailboxes, sit with another provider. Today a checklist in the toolkit walks you through moving those records to Cloudflare by hand, comparing each one twice. Next, your assistant is to lead that move with you. The plan is written; none of it is built yet.' },
  { title: 'Checks that go deeper and cannot be skipped', text: 'Required checks on the publishing branch, so a failing build cannot go live. Deeper checks on the message of a page. The starter has had a test for leftover template slots and filler text since release 0.30.' },
  { title: 'Listings where people look for plugins', text: "Croftweaver has been a plugin for Claude Code and for Codex since release 0.32, and it is listed on skills.sh. Next are listings in Anthropic's and OpenAI's own plugin directories." },
  { title: 'Import of an existing site', text: 'Bring the content and structure of a site you already have into the Croftweaver starter, under the same tests.' },
];
const later = [
  'A pipeline for regular posts.',
  'Starting from a screenshot or a design file.',
  'A few worked example sites to look at.',
];
const out = [
  { title: 'A visual editor.', text: 'You work with your assistant in plain language.' },
  { title: 'Shops and accounts.', text: 'An app builder serves you better there.' },
  { title: 'Hosting by us.', text: 'Your site stays on hosting you control.' },
  { title: 'A form that sends through a server.', text: "The visitor's own email program sends the message: it reads like a personal note, they keep a copy, and there is nothing for you to look after." },
];
---
<Base
  title="Roadmap: what is missing, what comes next"
  description="The Croftweaver roadmap: what is missing today, what comes next and in which order, and what stays out on purpose. No delivery dates; none of it is a promise."
  image="/images/og/roadmap.jpg"
>
  <section class="wrap hero">
    <h1>Roadmap: what is missing, what comes next</h1>
    <p class="lead">
      This roadmap lists what Croftweaver does not do yet, the order in which the
      gaps are meant to close, and what will stay out on purpose.
    </p>
    <p class="aside">
      There are no delivery dates here, and none of it is a promise. Croftweaver has one
      maintainer, and the order can change.
    </p>
    <p class="aside" id="reviewed">
      Read through against release {REVIEWED.version} on <time datetime={REVIEWED.iso}>{REVIEWED.label}</time>.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
    </div>
  </section>

  <section class="wrap" id="missing">
    <h2>Missing today</h2>
    <ul class="steps">
      <li><strong>Proof from more than one site.</strong> <a href="/proof">The proof page</a> shows one.</li>
      <li><strong>A lock on publishing.</strong> The tests run by default, but a person can still publish a build that failed. <a href="/checks">The test gate</a> says where.</li>
      <li><strong>Import.</strong> Croftweaver cannot yet bring the content and structure of an existing site into its starter. Checking and improving a site where it already lives works today: <a href="/established-sites">Croftweaver for established sites</a>.</li>
      <li><strong>Codex and Antigravity on more than one site.</strong> Each has been tested from start to finish on one site; Claude Code is the assistant Croftweaver is developed and used with.</li>
    </ul>
  </section>

  <section class="wrap" id="next">
    <h2>Next, in this order</h2>
    <ol class="steps">
      {next.map((item) => <li><strong>{item.title}.</strong> {item.text}</li>)}
    </ol>
  </section>

  <section class="wrap" id="done">
    <h2>Done in release 0.32</h2>
    <ul class="steps">
      <li><strong>A standard way to count enquiries.</strong> With Plausible on, your site counts each click on your email address as one <code>Email Tap</code>. With the usual script, it also counts each time the contact form asks the browser to open the visitor's mail program. Whether the visitor then writes and sends the mail, the site cannot know. New sites start with analytics off, so you switch Plausible on first.</li>
      <li><strong>An install without Node.</strong> As a Claude Code plugin, Croftweaver needs no Node, no script and no folder to keep. A Codex plugin came with it. <a href="/start#install">The quickstart</a> has the commands.</li>
    </ul>
    <p>
      The rest of what the release brought is in
      <a href={`${SITE.repo}/releases/tag/v0.32`}>its release notes</a>.
    </p>
  </section>

  <section class="wrap" id="later">
    <h2>Later, perhaps</h2>
    <ul class="steps">
      {later.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="wrap" id="out">
    <h2>Out, on purpose</h2>
    <ul class="steps">
      {out.map((item) => <li><strong>{item.title}</strong> {item.text}</li>)}
    </ul>
    <p>
      If one of these is what you need, <a href="/compare">the alternatives</a> page
      says which kind of tool fits. To argue for a change of order, open an issue
      on <a href={`${SITE.repo}/issues`}>GitHub</a>.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
      <a class="btn" href="/start">Quickstart</a>
    </div>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  section.hero { padding-top: 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1rem; hyphens: manual; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  section p, .steps { max-width: 46rem; line-height: 1.7; hyphens: manual; }
  .lead { font-size: 1.15rem; color: var(--muted); }
  .steps { padding-left: 1.3rem; }
  .steps li { margin-bottom: 0.6rem; }
</style>
