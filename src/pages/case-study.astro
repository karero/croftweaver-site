---
// /case-study — Croftweaver used on its own site, croftweaver.com, from launch onwards: a dated log
// of changes and observations, with the weekly AI check and Google's daily figures. Positioning term
// (tests/positioning.spec.ts): "case study". Owner decisions, 2026-10-21: its own page, its own
// export (scripts/export-own-site.py), counts only. Every figure comes from src/data/case-study.ts.
// Honesty rules (CONTENT_GUIDE.md): the page says what was seen after a change, never that it caused it.
// The hero answers "what was built, and can I inspect it?" first, with a dated screenshot of the live home
// page (public/images/case-study/), then four dated summaries, then the figures and the log (2026-10-27).
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { UPDATED, LAUNCH, LOG_NEWEST, prLabel, prPrivate, dayLabel, DAILY, SEARCH, AI_DAYS, BREAKS, BREAK_DAYS,
  SITE_REPO, CAPTURE, CARDS, TESTS_PR, measured } from '../data/case-study';

const named = (n: number, of: number) => `${n} of ${of}`;
const assistants = (n: number) => `${n} ${n === 1 ? 'assistant' : 'assistants'}`;
const latestAi = AI_DAYS[AI_DAYS.length - 1]!;
// The column headers are also the labels of the stacked rows on a phone (data-label), so they are written once.
const aiCols = ['Day', 'With search: named', 'croftweaver.com among the sources', 'Without search: named'];
const shot = (kind: string) => `/images/case-study/croftweaver-com-home-${kind}-${CAPTURE.iso}.webp`;
const testsPr = prLabel(TESTS_PR);
---
<Base
  title="Croftweaver case study: its own site"
  description="A Croftweaver case study you can inspect: croftweaver.com, its public source, the checks that ran on each change, and what Google and AI assistants showed."
  image="/images/og/case-study.jpg"
>
  <section class="wrap hero">
    <p class="kicker">Case study · live since <time datetime={LAUNCH.iso}>{LAUNCH.label}</time></p>
    <h1>A live website built with Croftweaver. Inspect it.</h1>
    <p class="lead">
      croftweaver.com is built and maintained with Croftweaver. You can look at the site, read its
      source, and see the checks that ran on each change and what Google and AI assistants showed
      after it. The early numbers are small, and the zeros stay in.
    </p>
    <div class="cta">
      <a class="btn primary" href="/">Open the live site</a>
      <a class="btn" href={SITE_REPO}>Read its source on GitHub</a>
      <a class="btn" href="#log">Jump to the log</a>
    </div>
    <p class="disclosure">
      This is the <a href="/about">maintainer</a>’s own website, not an independent customer project.
      It shows what Croftweaver produced here, not what it will produce for every site or every AI
      assistant.
    </p>
    <figure class="shots">
      <img src={shot('desktop')} width="1600" height="1000" loading="eager" fetchpriority="high"
        alt="The home page of croftweaver.com on a desktop screen: the Croftweaver logo and menu, a badge “Free and open source · MIT licence”, the line “Weave websites that rank.”, the headline “Build a complete website with AI.”, a subline on guiding your AI coding assistant to a tested website, three checked points, and the buttons “Get Croftweaver on GitHub” and “See a finished website”." />
      <img src={shot('phone')} width="585" height="1266" loading="lazy"
        alt="The same home page on a phone: the logo and a Menu button, the badge, the headline over two lines, the subline, the three checked points, and the GitHub button at the bottom edge." />
      <figcaption>
        The home page of croftweaver.com on a desktop screen and on a phone, captured from the live
        site on <time datetime={CAPTURE.iso}>{CAPTURE.label}</time>.
      </figcaption>
    </figure>
    <p class="aside">
      The log was last updated <time datetime={UPDATED.iso}>{UPDATED.label}</time>. A movement after a change
      is something we saw, not proof that the change caused it. For a site that is months old,
      see <a href="/proof">one site, measured</a>.
    </p>
  </section>

  <section class="wrap" id="summary">
    <h2>What the site shows so far</h2>
    <p>
      Croftweaver builds the site and checks it on every change. Google and AI assistants decide
      whether to show it. Each card gives the day or period of its figures, and where they come from.
    </p>
    <div class="cards">
      <article class="card">
        <h3>Technical output</h3>
        <dl>
          <div data-row="pages">
            <dt>Pages on the site</dt>
            <dd><span class="figure">{CARDS.google.pages}</span>, read on <time datetime={CARDS.google.date}>{dayLabel(CARDS.google.date)}</time></dd>
          </div>
          <div data-row="tests">
            <dt>Tests on the last change to this site in the log</dt>
            <dd><span class="figure">{CARDS.tests.tests}</span>, on <a href={TESTS_PR}>{testsPr}</a>, merged <time datetime={CARDS.tests.date}>{dayLabel(CARDS.tests.date)}</time></dd>
          </div>
        </dl>
        <p class="source">Source: the log below, and <a href={SITE_REPO}>the code on GitHub</a>. A test count says which checks ran, not that the site has no faults.</p>
      </article>
      <article class="card">
        <h3>Indexing</h3>
        <dl>
          <div data-row="google">
            <dt>Google</dt>
            <dd><span class="figure">{measured(CARDS.google.indexed, (n) => `${n} of ${CARDS.google.pages}`)}</span> pages indexed, read on <time datetime={CARDS.google.date}>{dayLabel(CARDS.google.date)}</time></dd>
          </div>
          <div data-row="bing">
            <dt>Bing</dt>
            <dd><span class="figure">{measured(CARDS.bing.indexed)}</span> since indexing of the home page was requested on <time datetime={CARDS.bing.date}>{dayLabel(CARDS.bing.date)}</time></dd>
          </div>
        </dl>
        <p class="source">Source: Google Search Console, URL inspection of every page; Bing Webmaster Tools. Indexed is not the same as ranked.</p>
      </article>
      <article class="card">
        <h3>Google search</h3>
        <p class="period">From <time datetime={SEARCH.from}>{dayLabel(SEARCH.from)}</time> to <time datetime={SEARCH.to}>{dayLabel(SEARCH.to)}</time></p>
        <dl>
          <div data-row="appearances">
            <dt>Appearances in Google’s results</dt>
            <dd><span class="figure">{SEARCH.impressions}</span></dd>
          </div>
          <div data-row="clicks">
            <dt>Clicks</dt>
            <dd><span class="figure">{SEARCH.clicks}</span></dd>
          </div>
        </dl>
        <p class="source">Source: Google Search Console, whole site, all countries, finished days (<a href="#search">by day, below</a>).</p>
      </article>
      <article class="card">
        <h3>AI answers</h3>
        <p class="period">On <time datetime={latestAi.date}>{latestAi.label}</time>, two questions that do not name Croftweaver</p>
        <dl>
          <div data-row="with-search-named">
            <dt>With web search, answers that named it</dt>
            <dd><span class="figure">{named(latestAi.withSearch.named, latestAi.withSearch.answers)}</span>, from {assistants(latestAi.withSearch.assistants)}</dd>
          </div>
          <div data-row="with-search-sources">
            <dt>With web search, croftweaver.com among the sources returned</dt>
            <dd><span class="figure">{named(latestAi.withSearch.sources, latestAi.withSearch.answers)}</span></dd>
          </div>
          <div data-row="without-search-named">
            <dt>Without web search, answers that named it</dt>
            <dd><span class="figure">{named(latestAi.withoutSearch.named, latestAi.withoutSearch.answers)}</span>, from {assistants(latestAi.withoutSearch.assistants)}</dd>
          </div>
        </dl>
        <p class="source">Source: Croftweaver’s weekly AI check (<a href="#ai">by day, below</a>). A source returned with an answer is not the same as a mention in it.</p>
      </article>
    </div>
  </section>

  <section class="wrap" id="ai">
    <h2>Do AI assistants name it?</h2>
    <p>
      Croftweaver's weekly AI check asks AI assistants two questions that do not name
      Croftweaver, with web search and without. On <time datetime={latestAi.date}>{latestAi.label}</time>,
      with web search, {named(latestAi.withSearch.named, latestAi.withSearch.answers)} answers from
      {assistants(latestAi.withSearch.assistants)} named it, and croftweaver.com was among the sources
      returned in {named(latestAi.withSearch.sources, latestAi.withSearch.answers)}. Without web search,
      {named(latestAi.withoutSearch.named, latestAi.withoutSearch.answers)} named it.
    </p>
    <div class="table-wrap stack figures" role="region" aria-label="The weekly AI check for croftweaver.com" tabindex="0">
      <table role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">{aiCols[0]}</th>
            <th scope="col" role="columnheader" class="num">{aiCols[1]}</th>
            <th scope="col" role="columnheader" class="num">{aiCols[2]}</th>
            <th scope="col" role="columnheader" class="num">{aiCols[3]}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {AI_DAYS.map((d) => (
            <tr role="row">
              <th scope="row" role="rowheader"><time datetime={d.date}>{d.label}</time>{BREAK_DAYS.has(d.date) && ' ‡'}</th>
              <td role="cell" class="num" data-label={aiCols[1]}>{named(d.withSearch.named, d.withSearch.answers)}</td>
              <td role="cell" class="num" data-label={aiCols[2]}>{named(d.withSearch.sources, d.withSearch.answers)}</td>
              <td role="cell" class="num" data-label={aiCols[3]}>{named(d.withoutSearch.named, d.withoutSearch.answers)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      “Among the sources” counts answers whose returned sources include croftweaver.com; for some
      assistants the check cannot tell whether the answer's text uses them, so this page does not
      call it a citation.
      {BREAKS.length > 0
        ? ' ‡ For at least one assistant, the question, the settings, the route or the model is not the same as before (a model is compared with the last day one was recorded), so this day is not compared with the day before.'
        : ' No question, setting or route changed between these days, and no assistant reported a different model.'}
      Counts only: the answers themselves are not published.
    </p>
  </section>

  <section class="wrap" id="search">
    <h2>What Google shows</h2>
    <p>
      From <time datetime={SEARCH.from}>{dayLabel(SEARCH.from)}</time> to
      <time datetime={SEARCH.to}>{dayLabel(SEARCH.to)}</time>, croftweaver.com appeared
      {SEARCH.impressions} {SEARCH.impressions === 1 ? 'time' : 'times'} in Google's results and was clicked {SEARCH.clicks}
      {SEARCH.clicks === 1 ? 'time' : 'times'}.
    </p>
    <div class="table-wrap figures" role="region" aria-label="Daily clicks and appearances in Google for croftweaver.com" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Day</th><th scope="col" class="num">Clicks</th><th scope="col" class="num">Appearances</th></tr>
        </thead>
        <tbody>
          {DAILY.map((r) => (
            <tr>
              <th scope="row"><time datetime={r.date}>{dayLabel(r.date)}</time></th>
              <td class="num">{r.clicks}</td>
              <td class="num">{r.impressions}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Source: Google Search Console, whole site, all countries, finished days only. The figures in
      files: <a href="/data/croftweaver-com-search-console.csv">Google, daily</a> and
      <a href="/data/croftweaver-com-ai-check.csv">the AI check</a>.
    </p>
  </section>

  <section class="wrap" id="log">
    <h2>The log</h2>
    <p class="note">
      A change is dated by the day its pull request was merged. It goes live when the site is next
      published, which can be a few days later.
    </p>
    <ol class="log" reversed>
      {LOG_NEWEST.map((e) => (
        <li class={e.kind}>
          <p class="when"><time datetime={e.date}>{dayLabel(e.date)}</time> · {e.kind === 'change' ? 'Change' : 'Observation'}</p>
          <h3>{e.title}</h3>
          {e.kind === 'change' ? (
            <>
              <p><strong>Asked:</strong> {e.asked}</p>
              <p>
                <strong>Pull request:</strong> {prPrivate(e.pr) ? <>{prLabel(e.pr)} (private repository)</> : <a href={e.pr}>{prLabel(e.pr)}</a>}.
                {e.checks ? <> <strong>Checks:</strong> {e.checks}.</> : <> The checks are in the pull request.</>}
              </p>
              <p><strong>Next measurement:</strong> {e.next ? <time datetime={e.next}>{dayLabel(e.next)}</time> : 'the next weekly check'}.</p>
            </>
          ) : (
            <>
              <p>{e.seen}</p>
              <p class="note">Source: {e.source}.</p>
            </>
          )}
        </li>
      ))}
    </ol>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
      <a class="btn" href="/proof">One site, measured</a>
    </div>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  section.hero { padding-top: 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1rem; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  section p { max-width: 46rem; line-height: 1.7; hyphens: manual; }
  .lead { font-size: 1.15rem; color: var(--muted); }
  .note, .aside { font-size: 0.9rem; color: var(--muted); }
  .log { list-style: none; padding: 0; margin: 0; max-width: 46rem; }
  .log li { border-left: 3px solid var(--line); padding: 0.2rem 0 0.8rem 1rem; margin-bottom: 1rem; }
  .log li.change { border-left-color: var(--accent, var(--pass)); }
  .log h3 { margin: 0.2rem 0 0.4rem; font-size: 1.1rem; }
  .log p { margin: 0.3rem 0; }
  .when { font-size: 0.85rem; color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  .kicker { margin: 0 0 0.6rem; color: var(--accent); font-weight: 600; }
  .disclosure { margin-top: 1.2rem; }
  .shots { display: grid; grid-template-columns: 3fr 1fr; gap: 1rem; align-items: start; margin: 2rem 0 1.5rem; }
  .shots img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius); }
  .shots figcaption { grid-column: 1 / -1; font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 40rem) {
    .shots { grid-template-columns: 1fr; }
    .shots img + img { max-width: 12rem; }
  }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; margin-top: 1.2rem; }
  .cards dl { margin: 0; }
  .cards dl > div { margin: 0 0 0.8rem; }
  .cards dt, .cards dd { hyphens: manual; }
  .cards dt { font-size: 0.9rem; color: var(--muted); }
  .cards dd { margin: 0.1rem 0 0; line-height: 1.5; }
  .figure { font-size: 1.35rem; font-weight: 700; }
  .card p { margin: 0 0 0.8rem; }
  .card .source { font-size: 0.85rem; color: var(--muted); margin: 0; }
</style>
