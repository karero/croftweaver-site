---
// /why — the case for the person who decides. Positioning term
// (tests/positioning.spec.ts): "search and AI visibility", in the title, the
// description and the H1. The argument follows the pitch deck; the copy is written
// fresh for this page and keeps to the wording rule (POSITIONING.md) and the honesty
// rules (CONTENT_GUIDE.md): no guarantee, and every figure comes from the same data
// as /proof (src/data/proof.ts), never typed here.
// The deck as a PDF download is added when the deck is refreshed (README, step 5a).
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { SUITE_COUNT } from '../data/suites';
import { PROOF, PROOF_MEASURED, SITE_PROOF } from '../data/proof';

const p = SITE_PROOF;
const speed = PROOF.find((entry) => entry.site === p.site)!;
const { blocks, peak, latest } = p.search;
const first = blocks[0]!;

const reasons = [
  { title: 'Built in from the first build', text: 'Search basics, trust signals and readability for AI assistants are part of every page by default. Tests check them before each push and on each pull request.' },
  { title: 'Improved after launch', text: 'Real search data replaces guesswork about keywords. It points to two or three edits a week that are worth making.' },
  { title: 'Owned, with no platform fee', text: 'A static site in your repository, on your domain. Webcroft is MIT-licensed and charges nothing.' },
];
const builtIn = [
  { title: 'Search basics', text: 'Titles and descriptions within set limits, structured data that says what each page is, a sitemap, links that all resolve.' },
  { title: 'Trust signals', text: 'Search engines look for experience, expertise, authority and trust. Webcroft builds the structure that carries yours: named authors, profiles that resolve, legal pages, sources. It cannot earn the reputation for you.' },
  { title: 'AI answers', text: 'People ask an assistant and read its answer. Assistants quote sources, so pages are written to be quotable, and every site ships a file that maps it for them.' },
  { title: 'Shared links', text: 'Every page gets its own share card at the size messengers accept. A page without one fails a test.' },
];
const steps = [
  { title: 'Brief', text: 'A few questions about your audience, your offer and your tone.' },
  { title: 'Build', text: 'Positioning first, then content, pages and metadata.' },
  { title: 'Check', text: `${SUITE_COUNT} test suites: accessibility, search, tone, links, images.` },
  { title: 'Launch', text: 'Live on your own domain, as static pages.' },
];
---
<Base
  title="Why build for search and AI visibility"
  description="The case for search and AI visibility as the first job of a website: built in from the first build, improved from real search data, in a site you own."
  image="/images/og/why.jpg"
>
  <section class="wrap hero">
    <h1>Why build a website for search and AI visibility</h1>
    <p class="lead">
      A website that nobody finds earns nothing. This page makes the case, for the
      person who decides, that search and AI visibility belong in the build and
      under test, not on a list of settings to get to later.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Webcroft on GitHub</a>
    </div>
  </section>

  <section class="wrap" id="recommendation">
    <h2>The recommendation, in three reasons</h2>
    <p>
      Choose a tool that is built for being found, not one that merely permits it.
    </p>
    <ol class="grid" role="list">
      {reasons.map((r) => (
        <li class="card"><h3>{r.title}</h3><p>{r.text}</p></li>
      ))}
    </ol>
  </section>

  <section class="wrap" id="problem">
    <h2>The difference is what the tool is for</h2>
    <p>
      A design tool hands you the controls. Knowing what to do, doing it on every
      page, and keeping it done stays your job. The work is right on the day
      someone does it, and nothing checks the next page.
    </p>
    <p>
      A tool built for being found does that work by default and tests it. The
      result is meant to hold on the hundredth page, two years later.
    </p>
    <p class="aside">
      None of this is a case against design. Search decides whether people arrive;
      design decides whether they stay. Both matter, in that order. If you use a
      website builder and like it, keep it, and ask what the site earns you in
      search.
    </p>
  </section>

  <section class="wrap" id="built-in">
    <h2>What is built in</h2>
    <div class="grid">
      {builtIn.map((b) => (
        <div class="card"><h3>{b.title}</h3><p>{b.text}</p></div>
      ))}
    </div>
    <p><a href="/checks">The test gate, suite by suite</a> says what is checked and what a pass does not prove.</p>
  </section>

  <section class="wrap" id="loop">
    <h2>What happens after launch</h2>
    <p>
      Google Search Console collects data only from the day a site is verified,
      so that is done at launch. From then on the skills read the data and point
      at edits:
    </p>
    <ul class="steps">
      <li><strong>Searches at position 8 to 20.</strong> Just below the first page, and the cheapest gains on a site.</li>
      <li><strong>Pages seen but not clicked.</strong> Often a title or a description, and quick to change.</li>
      <li><strong>Whether AI assistants name you.</strong> An optional weekly check, run with your own API keys.</li>
    </ul>
    <p>
      Each run is recorded, so you can see what moved. It can run weekly on a
      schedule that you switch on. Every edit goes back through the same tests.
    </p>
  </section>

  <section class="wrap" id="owned">
    <h2>What you own</h2>
    <ul class="steps">
      <li><strong>Plain files.</strong> The site is built once and served as static pages. There is no database to wait for or to keep alive.</li>
      <li><strong>No system to maintain.</strong> Content is text files in your repository: no login, no plugins to update. If someone needs an editing screen, an optional editor adds one and the content stays in the repository.</li>
      <li><strong>Room for a second language.</strong> It can be added later without moving the addresses you already have.</li>
      <li><strong>No fee to Webcroft.</strong> The licence is MIT. Your domain, your hosting and your AI assistant can still cost money.</li>
    </ul>
  </section>

  <section class="wrap" id="evidence">
    <h2>The evidence so far</h2>
    <p>
      One site, measured: <a href={p.url}>{p.site}</a>, relaunched on
      <time datetime={p.relaunched.iso}>{p.relaunched.label}</time>.
    </p>
    <ul class="steps">
      <li><strong>Speed and search basics.</strong> PageSpeed Insights on a simulated phone, {PROOF_MEASURED.label}: {speed.performance}, {speed.accessibility}, {speed.bestPractices} and {speed.seo} out of 100 for performance, accessibility, best practices and SEO.</li>
      <li><strong>Clicks from Google.</strong> From {first.clicks} in the 28 days around the relaunch to a best 28 days of {peak.clicks} ({peak.from} to {peak.to}), and {latest.clicks} in the latest 28 days ({latest.from} to {latest.to}).</li>
      <li><strong>AI assistants.</strong> On {p.ai.date.label}, {p.ai.withSearch.named} of {p.ai.withSearch.answers} answers given with web search named the site, and {p.ai.withoutSearch.named} of {p.ai.withoutSearch.answers} given from memory.</li>
    </ul>
    <p class="aside">
      It is one site, and it belongs to the maintainer of Webcroft. Clicks have
      fallen from their best, and the cause is not established.
      <a href="/proof">The proof page</a> has the sources, the daily numbers and
      what the figures do not show.
    </p>
  </section>

  <section class="wrap" id="steps">
    <h2>How it goes: four steps, and you decide at each</h2>
    <ol class="grid" role="list">
      {steps.map((s, i) => (
        <li class="card"><h3>{i + 1}. {s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
    <p>
      How long it takes depends on how much content you have and how fast the
      decisions are made. There is no honest number to print here.
    </p>
  </section>

  <section class="wrap" id="fit">
    <h2>Where it fits</h2>
    <p>
      Webcroft suits content sites: event and community sites, landing pages for
      a startup, expert and personal profiles, resource hubs, the site of a small
      studio or agency. For a shop, a booking platform or a web application,
      another kind of tool serves you better, and so does a managed builder if you
      want no code at all. <a href="/compare">Webcroft and its alternatives</a>
      says which.
    </p>
  </section>

  <section class="wrap" id="start">
    <h2>Start this week</h2>
    <ol class="steps">
      <li>Install an AI coding assistant and build one site from <a href="/start">the starter prompt</a>.</li>
      <li>Verify the site in Search Console on the first day. It collects no history before that.</li>
      <li>Read the first weekly report together, then decide whether to continue.</li>
    </ol>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Webcroft on GitHub</a>
      <a class="btn" href="/start">Quickstart</a>
    </div>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  section.hero { padding-top: 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1rem; hyphens: manual; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  section p, .steps { max-width: 46rem; line-height: 1.7; hyphens: manual; }
  .lead { font-size: 1.15rem; color: var(--muted); }
  .steps { padding-left: 1.3rem; }
  .steps li { margin-bottom: 0.6rem; }
  /* role="list" in the markup: Safari drops list semantics when list-style is none. */
  .grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem;
    margin: 1.2rem 0; padding: 0; list-style: none;
  }
  .card p { margin: 0; color: var(--muted); line-height: 1.6; max-width: none; }
</style>
