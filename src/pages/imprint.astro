---
// Imprint (Impressum) — required under German law (§ 5 DDG) for a site operated
// from Germany. The operator is M-Squad GmbH; the owner gave the company details on
// 9 October 2026, and on 11 October 2026 they were compared with the company's own
// imprint at https://m-squad.com/imprint: name, street, postcode, managing director,
// register court, register number and VAT number are the same there. A postal address,
// the managing director, the register entry and the VAT identification number are all
// part of what the law expects here.
import Base from '../layouts/Base.astro';
import EmailLink from '../components/EmailLink.astro';
import { COMPANY } from '../config';
---
<Base
  title="Imprint"
  description="Legal disclosure (Impressum) for croftweaver.com under German law: site operator, contact details, and responsibility for content.">
  <section class="wrap">
    <h1>Imprint</h1>
    <p>Legal disclosure under § 5 DDG (German Digital Services Act).</p>

    <h2>Site operator</h2>
    <p>
      {COMPANY.legalName}<br />
      Schellingstr. 141 Rgb.<br />
      80798 Munich, Germany
    </p>
    <p>Managing director: Daniel Melter</p>
    <p>
      Commercial register: Munich local court (Amtsgericht München), HRB 138 365<br />
      VAT identification number: DE218182722
    </p>
    <p>Contact: <EmailLink address="hello@croftweaver.com" subject="Croftweaver" /></p>

    <h2>Responsible for content</h2>
    <p>Daniel Melter (address as above).</p>

    <h2>About this site</h2>
    <p>
      croftweaver.com is the project page of Croftweaver, an open-source suite of
      website skills for AI coding assistants. The source code is published at
      <a href="https://github.com/karero/croftweaver">github.com/karero/croftweaver</a>.
    </p>

    <h2>Liability for links</h2>
    <p>
      This site links to external websites over whose content we have no
      control. The respective provider is responsible for the content of linked
      pages; at the time of linking, no legal violations were evident.
    </p>
  </section>
</Base>
