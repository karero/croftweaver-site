---
// Home page. Positioning spine (tests/positioning.spec.ts): the term
// "website skills" is threaded through <title> (config titleHome), the meta
// description (config description) and the kicker, which must stay the FIRST <p>
// in <main> (the H1 does not carry the term). The kicker also carries the market
// category "website skills for search and AI visibility".
// Wording rule (POSITIONING.md): the hero may promise what the product is for; the
// proof strip sits directly under it. Tone rules apply to all copy: no em dashes,
// no contractions, no buzzwords.
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { SUITES, SUITE_GROUPS, SUITE_COUNT } from '../data/suites';
import { PROOF, PROOF_MEASURED } from '../data/proof';

const LAB = 'https://genai-wednesday.de/builder-lab';
const rerun = (url: string) =>
  `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(url)}&form_factor=mobile`;

// What a failing check looks like: the message format of the title rule in
// tests/seo.spec.ts, with an example title of 63 characters.
const failure =
  '<title> "Opening hours, prices and how to find our studio | Harbour Yoga" is 63 chars > 60';
const install = `git clone ${SITE.repo}.git\ncd webcroft && ./scripts/install.sh`;

// Different schema type than the Builder Lab page on purpose (it owns FAQPage):
// this page describes the open-source project itself.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Webcroft',
  description: SITE.description,
  codeRepository: SITE.repo,
  runtimePlatform: 'Astro',
  about: 'Open-source website skills for search and AI visibility',
  author: { '@type': 'Person', name: 'Daniel Melter' },
};
---
<Base title={SITE.name} schemas={[softwareSchema]}>
  <section class="wrap hero">
    <p class="kicker">Website skills for search and AI visibility</p>
    <h1>Build websites that rank.</h1>
    <p class="subline">Keep improving SEO and GEO, week by week.</p>
    <p class="lead">
      Webcroft is a suite of open-source website skills for AI coding assistants.
      Your brief becomes an Astro site you own, built to rank on Google and show up
      in AI answers, with {SUITE_COUNT} test suites that check every change.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Webcroft on GitHub</a>
      <a class="btn" href="#quickstart">Quickstart</a>
    </div>
  </section>

  <section class="wrap" id="proof">
    <h2>Sites built with Webcroft, measured on <time datetime={PROOF_MEASURED.iso}>{PROOF_MEASURED.label}</time></h2>
    <p>
      The test is Google's PageSpeed Insights, on a simulated phone, for the home
      page of each site: one run each. Scores run from 0 to 100 and vary a little
      from run to run. The sites belong to the maintainer of Webcroft.
    </p>
    <ul class="grid proof-grid" role="list">
      {PROOF.map((p) => (
        <li class="card">
          <h3><a href={p.url}>{p.site}</a></h3>
          <dl class="scores">
            <div><dt>Performance</dt><dd>{p.performance}</dd></div>
            <div><dt>Accessibility</dt><dd>{p.accessibility}</dd></div>
            <div><dt>Best practices</dt><dd>{p.bestPractices}</dd></div>
            <div><dt>SEO</dt><dd>{p.seo}</dd></div>
          </dl>
          <a href={rerun(p.url)} aria-label={`Re-run the test for ${p.site}`}>Re-run the test</a>
        </li>
      ))}
    </ul>
    <p>
      These scores cover speed, accessibility, good practice and search basics. They
      say nothing about rankings, which depend on your content and your competition.
      For one of these sites, <a href="/proof">the proof page</a> adds its clicks
      from Google since the relaunch and a check of which AI assistants name it.
      The <a href={LAB}>Builder Lab at GenAI Wednesday</a>, where Webcroft began,
      keeps a full scorecard for the same site and its reviews by four AI
      assistants.
    </p>
  </section>

  <section class="wrap" id="problem">
    <h2>Capability is not the problem. Keeping it up is.</h2>
    <p>
      A website builder gives you the controls for search optimization: titles,
      descriptions, redirects, structured data. Using them stays your job, on every
      page and after every edit.
    </p>
    <p>
      Unless something checks after each edit, a site slips. A description goes
      missing, a link breaks, a share card shows the wrong picture, and nothing
      tells you.
    </p>
    <p>
      Webcroft takes the other route: do the work by default, then test it on every
      change.
    </p>
  </section>

  <section class="wrap" id="built-in">
    <h2>The search and AI work ships with the first build</h2>
    <p>You do not switch any of this on. The skills build it into every page:</p>
    <ul class="steps">
      <li>Titles and descriptions kept within set length limits.</li>
      <li>Structured data (schema.org JSON-LD) on every page, so a search engine can tell what the page is.</li>
      <li>An <code>llms.txt</code> file that maps your site for AI assistants.</li>
      <li>A sitemap, clean addresses and internal links that all resolve.</li>
      <li>A share card for every page, sized so messengers show a proper preview.</li>
      <li>Accessible markup and colours, in light and dark.</li>
    </ul>
    <p>
      The AI half of this has a name: GEO, short for generative engine optimization.
      It means building pages that assistants such as ChatGPT, Perplexity or Gemini
      can read and quote.
    </p>
  </section>

  <section class="wrap" id="checks">
    <h2>{SUITE_COUNT} test suites check every change</h2>
    <p>
      Every Webcroft site carries its own tests. By default they run before every
      push, and again on GitHub for every pull request. A change that breaks a rule
      fails there, before it reaches your visitors.
    </p>
    <div class="grid">
      {SUITE_GROUPS.map((group) => (
        <div class="card">
          <h3>{group.title}</h3>
          <ul class="checks" role="list">
            {SUITES.filter((s) => s.group === group.id).map((s) => (
              <li><strong>{s.name}.</strong> {s.checks}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p>A page title that runs too long, for example, fails with a message like this:</p>
    <pre class="message"><code>{failure}</code></pre>
    <p class="aside">
      A green run proves that these checks passed, nothing more. The positioning
      test proves the term is there, not that the positioning is good.
      <a href="/checks">The test gate, suite by suite</a>, says for each one what a
      pass does not prove.
    </p>
  </section>

  <section class="wrap" id="loop">
    <h2>After launch, search data drives the next edit</h2>
    <p>
      A launch is the start. Once you connect Google Search Console and it has data
      on your site, the skills read it and point at the two or three edits most
      worth making this week:
    </p>
    <ul class="steps">
      <li>Searches where you sit just below the first page of results.</li>
      <li>Pages that people see in the results but rarely click.</li>
      <li>An optional weekly check, run with your own API keys, that asks AI assistants the questions your buyers ask and counts how often they name you.</li>
    </ul>
    <p><a href="/skills">The skills</a> cover the whole life of a site, and every edit goes back through the same tests:</p>
    <ol class="flow" role="list">
      <li><strong>Build</strong><span>Brief, positioning, content, design.</span></li>
      <li><strong>Verify</strong><span>The test suites, then a two-pass review.</span></li>
      <li><strong>Launch</strong><span>Publish, and register with Search Console.</span></li>
      <li><strong>Grow</strong><span>Read the data, make the edits, weekly.</span></li>
    </ol>
    <p class="flow-back">From Grow, every edit returns to Verify.</p>
  </section>

  <section class="wrap" id="yours">
    <h2>The site is yours</h2>
    <p>
      Your code sits in your repository, your domain is in your name, and your
      pages are static files that any host can serve. Webcroft is MIT-licensed.
      There is no account and no subscription, and nothing runs on our servers.
    </p>
    <p>
      Install guides cover Claude Code, Codex and Antigravity.
    </p>
    <p class="aside">
      A croft is a small farm in the Scottish Highlands, worked by the family that
      lives on it: a modest piece of ground that feeds the people who tend it.
      Webcroft offers the same deal for the web, on ground you own. And yes, the
      name sits one vowel away from webcraft, on purpose.
    </p>
  </section>

  <section class="wrap" id="fit">
    <h2>Where Webcroft fits, and where it does not</h2>
    <div class="grid">
      <div class="card">
        <h3>A good fit</h3>
        <ul class="checks" role="list">
          <li>Event and community sites</li>
          <li>Startup landing pages</li>
          <li>Expert and personal profiles</li>
          <li>Resource hubs</li>
          <li>Small studio and agency sites</li>
        </ul>
      </div>
      <div class="card">
        <h3>Not a fit</h3>
        <ul class="plain" role="list">
          <li>Shops, accounts or anything that needs a database. An app builder serves you better.</li>
          <li>Drag-and-drop editing. You work with your assistant, in plain language.</li>
          <li>A hosted service. You publish to hosting you control.</li>
        </ul>
      </div>
    </div>
    <p>
      A contact form or one live widget is fine: the output supports a single
      serverless function when a site truly needs one.
    </p>
    <p>
      <a href="/compare">Webcroft and its alternatives</a> says when another kind of
      tool is the better choice, and <a href="/roadmap">the roadmap</a> says what is
      still missing.
    </p>
  </section>

  <section class="wrap" id="quickstart">
    <h2>Quickstart</h2>
    <ol class="steps">
      <li>Clone the repository and run the installer. This one is for Claude Code:</li>
    </ol>
    <pre tabindex="0"><code>{install}</code></pre>
    <ol class="steps" start="2">
      <li>Restart your assistant, then open it in a new, empty folder.</li>
      <li>Say: <em>new website</em>. The interview and the pipeline take it from there.</li>
    </ol>
    <p>
      <a href="/start">The full quickstart</a> has the one-prompt route, the
      installers for Codex and Antigravity, and the six questions the assistant
      asks.
    </p>
  </section>

  <section class="wrap signoff">
    <p class="plot">{SITE.tagline}</p>
    <a class="btn primary" href={SITE.repo}>Get Webcroft on GitHub</a>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  /* Prose at full measure reads better unhyphenated; the narrow cards keep the
     global hyphens: auto. */
  section p, .steps { max-width: 46rem; line-height: 1.7; hyphens: manual; }

  section.hero { padding-top: 3rem; }
  .kicker { margin: 0 0 0.6rem; color: var(--accent); font-weight: 600; }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); line-height: 1.08; margin: 0 0 0.6rem; }
  .subline { font-size: clamp(1.2rem, 2.6vw, 1.5rem); font-weight: 600; line-height: 1.35; margin: 0 0 1.2rem; }
  .lead { font-size: 1.15rem; color: var(--muted); }

  /* role="list" in the markup: Safari drops list semantics when list-style is none. */
  .grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem; margin: 1.2rem 0; padding: 0; list-style: none;
  }
  .card ul { margin: 0; padding: 0; list-style: none; line-height: 1.6; }
  .card li { margin-bottom: 0.5rem; padding-left: 1.5rem; position: relative; color: var(--muted); }
  .card li strong { color: var(--ink); }
  .checks li::before { content: '✓'; position: absolute; left: 0; color: var(--pass); font-weight: 700; }
  .plain li::before { content: '·'; position: absolute; left: 0.4rem; font-weight: 700; }

  .proof-grid .card { padding-left: 1.4rem; margin: 0; color: var(--ink); }
  .scores { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem 1rem; margin: 0 0 1rem; }
  .scores div { display: flex; flex-direction: column-reverse; }
  .scores dt { font-size: 0.85rem; color: var(--muted); }
  .scores dd { margin: 0; font-size: 2rem; font-weight: 700; line-height: 1.1; color: var(--pass); }

  .steps { padding-left: 1.3rem; }
  .steps li { margin-bottom: 0.5rem; }
  pre {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1rem 1.2rem; overflow-x: auto; max-width: 46rem;
  }
  /* A message reads better wrapped; commands keep their lines and scroll (the
     pre is focusable so a keyboard can scroll it). */
  pre.message { white-space: pre-wrap; overflow-wrap: anywhere; }
  code { font-size: 0.95rem; }

  .flow {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem; margin: 1.2rem 0 0.4rem; padding: 0; list-style: none; counter-reset: flow;
  }
  .flow li {
    counter-increment: flow; background: var(--surface); border: 1px solid var(--line);
    border-top: 3px solid var(--accent); border-radius: var(--radius);
    padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.3rem;
  }
  .flow strong::before { content: counter(flow) '. '; color: var(--accent); }
  .flow span { color: var(--muted); line-height: 1.5; }
  .flow-back { color: var(--muted); }
  .flow-back::before { content: '↩ '; color: var(--accent); font-weight: 700; }

  section.signoff { text-align: center; padding-bottom: 4rem; }
  .signoff .plot { max-width: none; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 700; margin: 0 0 1.2rem; }
</style>
