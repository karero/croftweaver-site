---
// Home page, told as the visitor's story (STORY.md; the seven sections in that order).
// Positioning spine (tests/positioning.spec.ts): the term "website skills" is threaded
// through <title> (config titleHome), the meta description (config description) and the
// kicker, which must stay the FIRST <p> in <main> (the H1 does not carry the term). The
// kicker says HOW the site gets built; the header's claim above it says what for. The
// market category "website skills for search and AI visibility" stands in the first
// paragraph of "What Croftweaver is" (it stood in the kicker until 2026-10-12). Under the
// one-liner, one sentence says what Croftweaver is (owner, 2026-10-13; POSITIONING.md).
// Wording rule (POSITIONING.md): promises in the active voice, no guarantee; the proof
// strip sits directly under the hero. Tone rules apply to all copy: no em dashes, no
// contractions, no buzzwords. The direct call to action keeps one label everywhere.
import Base from '../layouts/Base.astro';
import EmailLink from '../components/EmailLink.astro';
import { SITE, COMPANY, schemaId } from '../config';
import { SUITE_COUNT } from '../data/suites';
import { PANEL, fmtScore } from '../data/proof';
import { PROOF, PROOF_MEASURED, SITE_PROOF } from '../data/proof';

const tryIt = 'Score genai-wednesday.de for SEO and GEO, with one sentence of reason for each score. Then do the same for [your site\'s address].';

// The two measured figures under the AI panel (owner, 2026-10-13). They are read from the
// data behind /more-proof and /proof, so the three pages cannot disagree.
if (PROOF.length !== 3) throw new Error('src/pages/index.astro says "three sites" in the proof section: change the word with the list in src/data/proof.ts.');
const pageSpeed = PROOF.flatMap((p) => [p.performance, p.accessibility, p.bestPractices, p.seo]);
const pageSpeedRange = Math.min(...pageSpeed) === Math.max(...pageSpeed) ? `${Math.max(...pageSpeed)}` : `${Math.min(...pageSpeed)} to ${Math.max(...pageSpeed)}`;
const ai = SITE_PROOF.ai;

const install = `git clone ${SITE.repo}.git\ncd croftweaver && ./scripts/install.sh`;

// Different schema type than the Builder Lab page on purpose (it owns FAQPage):
// this page describes the open-source project itself. The software and its maintainer
// have their own @id, apart from the operator's (src/config.ts says why).
const origin = (Astro.site ?? new URL(SITE.url)).origin;
const softwareId = schemaId(origin, 'software');
const maintainerId = schemaId(origin, 'daniel-melter');
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': softwareId,
  name: SITE.name,
  url: `${origin}/`,
  description: SITE.description,
  image: new URL(COMPANY.logo, origin).href,
  codeRepository: SITE.repo,
  license: `${SITE.repo}/blob/main/LICENSE`,   // MIT; the file names Daniel Melter as the copyright holder
  runtimePlatform: 'Astro',
  about: 'Open-source website skills for search and AI visibility',
  author: { '@id': maintainerId },
  maintainer: { '@id': maintainerId },
};
// The section #maintainer on this page says the same in words. LinkedIn is in the
// structured data only, not on the page (owner, 2026-10-13); LinkedIn redirects the address
// with a trailing slash to this one. The team page and the GitHub account are the ones
// M-Squad's own site gives for him (https://m-squad.com/company/team, read 2026-10-13).
const maintainerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': maintainerId,
  name: 'Daniel Melter',
  url: `${origin}/#maintainer`,
  worksFor: { '@id': schemaId(origin, 'organization') },
  sameAs: [
    'https://www.linkedin.com/in/danielmelter',
    'https://m-squad.com/company/team',
    'https://github.com/karero',
  ],
};
---
<Base title={SITE.name} schemas={[softwareSchema, maintainerSchema]} mainEntity={softwareId}>
  <section class="wrap hero">
    <p class="kicker">Your AI assistant, guided by website skills</p>
    <h1>Weave websites that rank.</h1>
    <p class="lead">
      Stop waiting on someone else for every change. Build or rebuild your site with
      your AI assistant and Croftweaver, so people can find it on Google and in AI
      answers.
    </p>
    <p class="what">
      Croftweaver is a free, open-source suite of website skills: instructions your AI
      coding assistant follows to build and test a site you own.
    </p>
    <p class="for">For founders, communities, experts and small teams.</p>
    <ul class="outcomes" role="list">
      <li>You make the everyday changes yourself</li>
      <li>Search and AI can read it from the first build</li>
      <li>You catch common slips: {SUITE_COUNT} test suites check every change by default</li>
    </ul>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
      <a class="btn" href="#quickstart">Quickstart</a>
    </div>
    <p class="fineprint">No coding needed to start: you work with your assistant in plain language.</p>
  </section>

  <section class="wrap" id="proof">
    <h2>Four AI assistants scored a site built with Croftweaver</h2>
    <p>
      The <a href={PANEL.lab}>Builder Lab at GenAI Wednesday</a> gave four AI assistants
      the same prompt about genai-wednesday.de on <time datetime={PANEL.date.iso}>{PANEL.date.label}</time>. SEO is how well
      Google can find and read a site. GEO, short for generative engine optimization, is
      how well AI assistants such as ChatGPT, Perplexity or Gemini can read and quote it.
      GEO has no official scorer, and the SEO scores here are the assistants' own opinions
      too, not a Google metric. They are not rankings, they vary from run to run, and they
      do not show that an assistant would recommend the site. The site belongs to the maintainer of Croftweaver.
    </p>
    <div class="table-wrap" role="region" aria-label="SEO and GEO scores from four AI assistants for genai-wednesday.de" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Assistant</th><th scope="col" class="num">SEO</th><th scope="col" class="num">GEO</th></tr>
        </thead>
        <tbody>
          {PANEL.rows.map((row) => (
            <tr><th scope="row">{row.assistant}</th><td class="num">{fmtScore(row.seo)}</td><td class="num">{fmtScore(row.geo)}</td></tr>
          ))}
          <tr class="avg"><th scope="row">Panel average</th><td class="num">{fmtScore(PANEL.average.seo)}</td><td class="num">{fmtScore(PANEL.average.geo)}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      Scores out of 10, as the Builder Lab shows them (read on <time datetime={PANEL.readOn.iso}>{PANEL.readOn.label}</time>).
      Gemini (Antigravity) answers out of 100 and the Lab shows it out of 10. The Lab
      warns that scores are not comparable between assistants, so read the average as a
      rough guide. GEO ranges from {fmtScore(PANEL.geoLow)} to {fmtScore(PANEL.geoHigh)}.
    </p>
    <h3>Try it on your own site</h3>
    <p>
      Paste this into your own AI assistant and replace the part in brackets with your
      site's address. Your scores will differ from these: they are opinions. The Lab's
      own prompt is on <a href="/more-proof#eeat">More proof</a>.
    </p>
    <pre class="message"><code>{tryIt}</code></pre>
    <p>
      <strong>Measured, not scored.</strong> On <time datetime={PROOF_MEASURED.iso}>{PROOF_MEASURED.label}</time>,
      Google's PageSpeed Insights gave three sites built with Croftweaver, all of them the
      maintainer's own, scores of {pageSpeedRange} out of 100 across its four categories.
      <a href="/more-proof">More proof</a> has the figures, and how the same four
      assistants score trust. On <time datetime={ai.date.iso}>{ai.date.label}</time>,
      {ai.withSearch.named} of {ai.withSearch.answers} answers from AI assistants with web
      search named {SITE_PROOF.site}; without web search, {ai.withoutSearch.named} of {ai.withoutSearch.answers} did.
      <a href="/proof">One site in depth</a> has the counts and the site's clicks from Google.
    </p>
  </section>

  <section class="wrap" id="voice">
    <h2>From someone who built her own site</h2>
    <figure class="card voice">
      <img src="/images/testimonials/andrea-geistanger.webp" alt="Portrait of Dr. Andrea Geistanger" width="88" height="88" loading="lazy">
      <blockquote><p>“The first version of my website is live. Without the Builder it wouldn’t have been possible — especially not with all the small but important details that, as a non-professional, you don’t think about at all. Many thanks for this great project.”</p></blockquote>
      <figcaption><strong>Dr. Andrea Geistanger</strong> Bilingual site EN/DE · <a href="https://www.geistanger-consulting.com/">geistanger-consulting.com</a> · Translated from German</figcaption>
    </figure>
    <p class="note">
      By “the Builder” she means this toolkit, which took the name Croftweaver on
      <time datetime="2026-10-12">12 October 2026</time>.
    </p>
  </section>

  <section class="wrap" id="problem">
    <h2>Every change waits on someone else</h2>
    <p>
      Many sites start from an old page nobody dares to touch, or from nothing at all.
      Every update means asking someone else: a brief, a wait, often a bill. So changes
      pile up, and the site falls behind.
    </p>
    <p>
      The work that gets a site found is the first to go. A description goes missing, a
      link breaks, a share card shows the wrong picture, and nothing tells you.
    </p>
    <p>
      So when someone hears your name and looks you up, the site makes a weaker case
      than you would yourself. And the people who do not know you yet have a harder
      time finding you.
    </p>
    <p>
      Croftweaver takes the other route. Your assistant starts with your positioning,
      what you offer and for whom, and from then on a test keeps your pages on it:
      <a href="/positioning">Positioning first</a>. It can also tell the home page as your
      visitor's story. Then you and your assistant make the changes, the search and AI
      work is done by default, and the tests check it by default.
      <a href="/why">Why build for search and AI visibility</a> makes the full case, for
      the person who decides.
    </p>
  </section>

  <section class="wrap" id="plan">
    <h2>Three steps to a site people can find</h2>
    <ol class="flow" role="list">
      <li><strong>Describe</strong><span>Say <em>new website</em> to your assistant and answer its questions. It works out what the site says before it writes a word.</span></li>
      <li><strong>Build and check</strong><span>Your assistant builds the pages with the search and AI work done by default, and {SUITE_COUNT} test suites check every change by default.</span></li>
      <li><strong>Publish and keep improving</strong><span>Publish on hosting you control, such as Cloudflare's free plan. Once you connect Google Search Console, your own data points to the next edit, week by week.</span></li>
    </ol>
    <p>
      Rebuilding an old site? Tell your assistant what the old site says. There is no
      automatic import yet; <a href="/roadmap">the roadmap</a> says what is missing.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
    </div>
  </section>

  <section class="wrap" id="life">
    <h2>What changes for you</h2>
    <div class="grid">
      <div class="card">
        <h3>You make the changes yourself</h3>
        <p>Everyday updates (text, pages, images and layout) are a conversation with your assistant. No brief, and nobody to wait for. A stubborn problem can still need outside help. <a href="#yours">The site is yours</a>.</p>
      </div>
      <div class="card">
        <h3>Search and AI can read it from the first build</h3>
        <p>Titles, structured data, a map for AI assistants, a sitemap and clean links are built into every site. <a href="#checks">What ships with the first build</a>.</p>
      </div>
      <div class="card">
        <h3>You catch common slips</h3>
        <p>{SUITE_COUNT} test suites check every change by default, and your own search data points to the next edit. <a href="/checks">The test suites</a> and <a href="#loop">the weekly loop</a>.</p>
      </div>
    </div>
    <p class="scene">
      <strong>A change, start to finish.</strong> You tell your assistant: <em>make the
      opening line of the About page shorter</em>. It edits the page, the test suites
      check the change, and you publish it yourself. There is no brief to write and no
      one to wait for.
    </p>
  </section>

  <section class="wrap" id="guide">
    <h2>What Croftweaver is, and what people ask</h2>
    <p>
      Croftweaver is a free, open-source suite of website skills for search and AI
      visibility, made for AI coding assistants. It turns an assistant such as Claude Code into a careful website
      builder: fast, accessible Astro sites, built to rank on Google and show up in AI
      answers, in a repository you own.
    </p>
    <p>
      The search and AI work is the part that gets skipped when a site has to go live
      fast. Croftweaver does that work by default, and by default the tests check it. The proof is above.
      <a href="/more-proof">More proof</a> and <a href="/proof">one site in depth</a> are
      measured and dated.
    </p>
    <dl class="qa">
      <div>
        <dt>Do I need to code?</dt>
        <dd>Not to start. You work with your assistant in plain language, and <a href="/start#prompt">the starter prompt</a> asks it to explain every command and to install a tool only when the site needs it.</dd>
      </div>
      <div>
        <dt>Will it rank my site?</dt>
        <dd>Croftweaver builds in the search and AI basics and, by default, tests them. It cannot promise a ranking: that depends on your content and your competition.</dd>
      </div>
      <div>
        <dt>What does it cost?</dt>
        <dd>Croftweaver itself is free and MIT-licensed, a GitHub account and a Cloudflare account are free to open, and <a href="#cost">Cloudflare's free plan hosts the site</a>. You still pay for your domain. Your AI assistant can cost money, and so can the optional weekly AI check.</dd>
      </div>
      <div>
        <dt>Is it safe to install?</dt>
        <dd>The skills are plain text instructions and small scripts in a public repository, so you or your assistant can read every one before you install it. In its default settings, Claude Code asks before it runs a command. The site it builds is static files, with no database and no user accounts.</dd>
      </div>
      <div>
        <dt>Can my site have a contact form?</dt>
        <dd>Yes, and ours works differently on purpose. The visitor fills in a few fields, and their own email program opens with the message written, ready to send. It comes from their own address, so it reads like a personal note, and you answer with Reply. Their email program keeps a copy in their Sent folder, as it does for any email, so they can see that it left. There is no form service to pay for or look after, nothing for a spam bot to fire off, and no message stored on a server. A visitor without an email program copies the address shown under the form.</dd>
      </div>
    </dl>
  </section>

  <section class="wrap" id="checks">
    <h2>Built in from the first build, checked on every change</h2>
    <p>You do not switch any of this on. The skills build it into every page:</p>
    <ul class="steps">
      <li>Titles and descriptions kept within set length limits.</li>
      <li>Structured data (schema.org JSON-LD) on every page, so a search engine can tell what the page is.</li>
      <li>An <code>llms.txt</code> file that maps your site for AI assistants. It does not guarantee that an assistant reads it.</li>
      <li>A sitemap, clean addresses and internal links that all resolve.</li>
      <li>A share card for every page, sized so messengers show a proper preview.</li>
      <li>Accessible markup and colours, in light and dark.</li>
    </ul>
    <p>
      Every Croftweaver site also carries its own tests: {SUITE_COUNT} test suites. By
      default they run before every push, and again on GitHub for every pull request. A
      change that breaks a rule fails there, so by default it does not reach your visitors.
    </p>
    <p class="aside">
      A green run proves that the tests passed, nothing more. The positioning test, for
      example, proves that this page carries its key term in its title, description and
      opening, not that the positioning is good.
      <a href="/checks">The test gate, suite by suite</a>, says what each suite checks
      and what a pass does not prove. How the positioning itself is worked out, before
      any copy: <a href="/positioning">Positioning first</a>.
    </p>
  </section>

  <section class="wrap" id="loop">
    <h2>After launch, the next edit, tested</h2>
    <p>
      Knowing where you stand is the easy part: Search Console shows how you do on
      Google, and plenty of tools check whether AI assistants name you. What moves a
      site is the next change to it. Once you connect Google Search Console and it has
      data on your site, the skills read it and point at the two or three edits most
      worth making this week:
    </p>
    <ul class="steps">
      <li>Searches where you sit just below the first page of results.</li>
      <li>Pages that people see in the results but rarely click.</li>
      <li>An optional weekly check, run with your own API keys, that asks AI assistants the questions your customers ask and counts how often they name you.</li>
    </ul>
    <p>Your assistant makes the edit with you, and the same tests run on it, by default before every push and on every pull request. <a href="/skills">The skills</a> cover the whole life of a site:</p>
    <ol class="flow" role="list">
      <li><strong>Build</strong><span>Brief, positioning, content, design.</span></li>
      <li><strong>Verify</strong><span>The test suites, then a two-pass review.</span></li>
      <li><strong>Launch</strong><span>Publish, and register with Search Console.</span></li>
      <li><strong>Grow</strong><span>Read the data, make the edits, weekly.</span></li>
    </ol>
    <p class="flow-back">From Grow, every edit returns to Verify.</p>
  </section>

  <section class="wrap" id="yours">
    <h2>The site is yours</h2>
    <p>
      Your code sits in your repository, your domain is in your name, and your
      pages are static files that any host can serve. Croftweaver is MIT-licensed.
      It has no account and no subscription, and nothing runs on our servers.
    </p>
    <p>
      Install guides cover Claude Code, Codex and Antigravity. Croftweaver is developed
      and used with Claude Code; it has not been tested from start to finish with Codex
      or Antigravity yet.
    </p>
    <p class="aside">
      A croft is a small farm in the Scottish Highlands, worked by the family that
      lives on it: a modest piece of ground that feeds the people who tend it.
      Croftweaver offers the same deal for the web, on ground you own. The weaver is
      your AI assistant. The plot stays yours.
    </p>
  </section>

  <section class="wrap" id="learn">
    <h2>A good first AI project, alone or with your team</h2>
    <p>
      AI stops being abstract when it works on your own site. You know what it should
      say, you see each change take shape, and you decide what stays. In my experience
      it is a real learning curve, and a happy one. Questions along the way? I am glad
      to help. Write to
      <EmailLink address={COMPANY.email} subject="A question about Croftweaver" />.
    </p>
    <p class="byline">Daniel Melter, maintainer of Croftweaver</p>
  </section>

  <section class="wrap" id="maintainer">
    <h2>Who maintains Croftweaver</h2>
    <p>
      Croftweaver has one maintainer, Daniel Melter. He co-founded M-Squad in 2001 and
      leads it today, and he has worked in product development for mobile and telecom
      for more than 20 years. M-Squad GmbH, in Munich, operates this site. He co-built the
      community GenAI Wednesday and still co-organizes it in Munich, and Croftweaver
      grew out of its website, <a href="https://genai-wednesday.de/">genai-wednesday.de</a>.
    </p>
    <p>
      His profile is on <a href="https://m-squad.com/company/team">M-Squad's team page</a>.
      The code is on <a href={SITE.repo}>GitHub</a> under the MIT licence, and the
      <a href="/imprint">imprint</a> has the company's address. A note from him is on
      <a href="/about">the About page</a>.
    </p>
  </section>

  <section class="wrap" id="fit">
    <h2>Where Croftweaver fits, and where it does not</h2>
    <div class="grid">
      <div class="card">
        <h3>A good fit</h3>
        <ul class="checks" role="list">
          <li>Event and community sites</li>
          <li>Startup landing pages</li>
          <li>Expert and personal profiles</li>
          <li>Resource hubs</li>
          <li>Small studio and agency sites</li>
        </ul>
      </div>
      <div class="card">
        <h3>Not a fit</h3>
        <p>Another kind of tool serves you better if you want:</p>
        <ul class="plain" role="list">
          <li>a shop, user accounts or anything that needs a database: an app builder</li>
          <li>drag-and-drop editing: a visual builder, hosted or open source</li>
          <li>hosting and editor from one company: a hosted website builder</li>
        </ul>
      </div>
    </div>
    <p>
      A contact form or one live widget is fine: the output supports a single
      serverless function when a site truly needs one.
    </p>
    <p>
      <a href="/compare">Croftweaver and its alternatives</a> says when another kind of
      tool is the better choice, and <a href="/roadmap">the roadmap</a> says what is
      still missing.
    </p>
  </section>

  <section class="wrap" id="cost">
    <h2>You pay nothing for hosting</h2>
    <p>Build your site with your AI assistant, then run it on two free accounts.</p>
    <ul>
      <li>Your site's files live in your own GitHub account. <a href="https://github.com/about">About GitHub</a>.</li>
      <li>Cloudflare hosts the site on its free plan. Cloudflare says it proxies about 20% of the web. <a href="https://www.cloudflare.com/what-is-cloudflare/">What Cloudflare is</a>.</li>
      <li>You still pay for your domain, and for your AI assistant if you use a paid plan.</li>
    </ul>
    <p class="aside">
      Rebuilding a site you already have? Before you cancel the old hosting plan, check
      what else runs on it: your domain and your email.
      <a href="/start#rebuild">Three checks before you cancel</a>.
    </p>
    <p>
      Cloudflare's free plan has limits, and
      <a href="https://developers.cloudflare.com/pages/platform/limits/">its own page lists them</a>.
      GitHub's free plan is on <a href="https://github.com/pricing">GitHub's plans</a>.
      Both pages and Cloudflare's 20% figure were read on
      <time datetime="2026-10-12">12 October 2026</time>.
    </p>
  </section>

  <section class="wrap" id="quickstart">
    <h2>Quickstart</h2>
    <p>
      The easy way is one prompt. The starter prompt asks your assistant to do the
      typing, explain every command and install a tool only when the site needs it.
    </p>
    <ol class="steps">
      <li>Install an AI coding assistant, such as Claude Code, and open it. You also need a free GitHub account and a computer (<a href="/start#need">what you need</a>).</li>
      <li>Paste <a href="/start#prompt">the starter prompt</a> and send it.</li>
      <li>Answer its questions. It builds the site from your answers.</li>
    </ol>
    <h3>Or install by hand</h3>
    <ol class="steps">
      <li>Clone the repository and run the installer. This one is for Claude Code:</li>
    </ol>
    <pre tabindex="0"><code>{install}</code></pre>
    <ol class="steps" start="2">
      <li>Restart your assistant, then open it in a new, empty folder.</li>
      <li>Say: <em>new website</em>. The interview and the pipeline take it from there.</li>
    </ol>
    <p>
      <a href="/start">The full quickstart</a> has the starter prompt in full, the
      installers for Codex and Antigravity, and the six questions the assistant asks.
    </p>
  </section>

  <section class="wrap signoff">
    <p class="plot">{SITE.tagline}</p>
    <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  /* Prose at full measure reads better unhyphenated, and so do the short cards and
     answers below (hyphens: manual); the lists in the fit cards keep the global
     hyphens: auto. */
  section p, .steps { max-width: 46rem; line-height: 1.7; hyphens: manual; }

  section.hero { padding-top: 3rem; }
  .kicker { margin: 0 0 0.6rem; color: var(--accent); font-weight: 600; }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); line-height: 1.08; margin: 0 0 0.6rem; }
  .hero .lead {
    font-size: clamp(1.2rem, 2.6vw, 1.5rem); font-weight: 600; line-height: 1.4;
    color: var(--ink); max-width: 40rem; margin: 0 0 0.6rem;
  }
  .hero .what { max-width: 40rem; margin: 0 0 0.6rem; }
  .hero .for { margin: 0 0 1.2rem; color: var(--muted); }
  .hero .fineprint { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .scene { margin-top: 1.4rem; }
  /* role="list" in the markup: Safari drops list semantics when list-style is none. */
  .outcomes { list-style: none; padding: 0; margin: 0 0 1.4rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; color: var(--muted); }
  .outcomes li { padding-left: 1.5rem; position: relative; }
  .outcomes li::before { content: '✓'; position: absolute; left: 0; color: var(--pass); font-weight: 700; }
