---
// /about — who is behind Croftweaver: a note from the maintainer, in his own words
// (owner-approved 2026-10-14), and the facts about him that the home page's section
// #maintainer also gives (STORY.md). Positioning term (tests/positioning.spec.ts):
// "maintainer", in the title, the description and the intro paragraph.
// No figure is typed here: the PageSpeed scores and the clicks come from
// src/data/proof.ts, the same data as /more-proof, /proof and /why. Help with a site is
// outside the open-source project and billed by M-Squad (owner, 2026-10-14); the note
// names no price on purpose.
import Base from '../layouts/Base.astro';
import EmailLink from '../components/EmailLink.astro';
import { SITE, COMPANY } from '../config';
import { PROOF, PROOF_MEASURED, SITE_PROOF } from '../data/proof';

if (PROOF.length !== 3) throw new Error('src/pages/about.astro says "three sites, all three of them mine": change the words with the list in src/data/proof.ts.');
const scores = PROOF.flatMap((p) => [p.performance, p.accessibility, p.bestPractices, p.seo]);
const low = Math.min(...scores);
const high = Math.max(...scores);
const scoreWords = low === high ? `${high}` : high - low === 1 ? `${low} or ${high}` : `${low} to ${high}`;
const { blocks, peak, latest } = SITE_PROOF.search;
const first = blocks[0]!;
---
<Base
  title="About Croftweaver and its maintainer"
  description="About Croftweaver and its maintainer, Daniel Melter: why he builds website skills for search and AI visibility, what his sites measure, and how to reach him."
  image="/images/og/about.jpg"
>
  <section class="wrap hero">
    <h1>About Croftweaver</h1>
    <p class="lead">
      Croftweaver is a free, open-source suite of website skills for AI coding
      assistants. It has one maintainer, Daniel Melter, in Munich.
    </p>
  </section>

  <section class="wrap" id="note">
    <h2>A note from the maintainer</h2>
    <div class="note">
      <img src="/images/about/daniel-melter.webp" alt="Portrait of Daniel Melter" width="88" height="88" loading="lazy">
      <div class="quote">
        <p>
          Croftweaver does the part of web work I like best: giving a site order. First you
          settle what you offer and for whom. Then that answer goes into every page and into
          the data behind it, in a form search engines and AI assistants can read.
        </p>
        <p>
          The pages stay light: plain static files, quick to load. On
          <time datetime={PROOF_MEASURED.iso}>{PROOF_MEASURED.label}</time>, Google PageSpeed
          Insights tested the home pages of <a href="/more-proof">three sites built this way</a>,
          all three of them mine, on mobile. Each scored {scoreWords} out of 100 in all four
          categories. One of them is genai-wednesday.de, the site of the community I built in
          Munich. Its <a href="/proof">clicks from Google</a> rose from {first.clicks} per 28 days
          around its launch to a best of {peak.clicks}, and stood at {latest.clicks} in the 28 days
          to <time datetime={latest.toIso}>{latest.to}</time>.
        </p>
        <p>
          Can I help with your site? Write to
          <EmailLink address={COMPANY.email} subject="A question about my site" /> and tell me
          what it is for and where it stands.
        </p>
      </div>
      <p class="byline">Daniel Melter, maintainer of Croftweaver</p>
    </div>
  </section>

  <section class="wrap" id="maintainer">
    <h2>Who maintains Croftweaver</h2>
    <p>
      Daniel Melter co-founded M-Squad in 2001 and leads it today, and he has worked in
      product development for mobile and telecom for more than 20 years. M-Squad GmbH, in
      Munich, operates this site. He built the community GenAI Wednesday and still
      co-organizes it in Munich, and Croftweaver grew out of its website,
      <a href="https://genai-wednesday.de/">genai-wednesday.de</a>.
    </p>
    <p>
      His profile is on <a href="https://m-squad.com/company/team">M-Squad's team page</a>.
      The code is on <a href={SITE.repo}>GitHub</a> under the MIT licence, and the
      <a href="/imprint">imprint</a> has the company's address.
    </p>
    <div class="cta">
      <a class="btn primary" href={SITE.repo}>Get Croftweaver on GitHub</a>
      <a class="btn" href="/start">Quickstart</a>
    </div>
  </section>
</Base>

<style>
  section.wrap { padding: 2.5rem 1.25rem; max-width: var(--maxw); margin: 0 auto; }
  section.hero { padding-top: 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1rem; hyphens: manual; }
  h2 { margin-bottom: 0.8rem; line-height: 1.25; }
  section p { max-width: 46rem; line-height: 1.7; hyphens: manual; }
  .lead { font-size: 1.15rem; color: var(--muted); }
  /* The note reads as a quote, but in a div rather than a <blockquote>: tests/tone.spec.ts
     skips blockquotes, and this is the site's own copy, so the tone check keeps covering it. */
  .quote { font-style: italic; border-left: 3px solid var(--accent); padding-left: 1.25rem; }
  /* Photo beside the note, as the testimonial on the home page; above it on a phone. */
  .note { display: grid; grid-template-columns: 88px 1fr; gap: 0 1.4rem; max-width: 46rem; }
  .note img { grid-row: 1 / 3; width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
  .note .quote p:first-child { margin-top: 0; }
  @media (max-width: 40rem) {
    .note { grid-template-columns: 1fr; }
    .note img { grid-row: auto; margin-bottom: 1rem; }
  }
  .byline { color: var(--muted); font-size: 0.95rem; margin-top: 0.4rem; }
</style>
