---
// Crawler-resistant phone number, hidden the way EmailLink hides an address. The digits
// NEVER appear in the HTML source: the number is reversed + base64-encoded at build time
// and put back in the browser. No-JS visitors read the digits as words.
//
//   <PhoneNumber number="+49 30 1234567" />
import { encodePhone, phoneHint } from '../lib/obfuscate';

interface Props {
  number: string;
  class?: string;
}
const { number, class: className } = Astro.props;
---
<span class:list={['phone-number', className]} data-phone={encodePhone(number)}>{phoneHint(number)}</span>

<script>
  // Put the number back on the client; it is not in the served HTML.
  for (const el of document.querySelectorAll<HTMLElement>('.phone-number[data-phone]')) {
    try {
      el.textContent = atob(el.dataset.phone!).split('').reverse().join('');
      el.removeAttribute('data-phone');
    } catch {
      /* leave the no-JS hint in place */
    }
  }
</script>
