---
// Crawler-resistant phone number, hidden the way EmailLink hides an address. The digits
// NEVER appear in the HTML source: the number is reversed + base64-encoded at build time
// and put back in the browser, as a link that a phone can call. No-JS visitors read the
// digits as words.
//
//   <PhoneNumber number="+49 30 1234567" />
import { encodePhone, phoneHint } from '../lib/obfuscate';
import { SITE } from '../config';

interface Props {
  number: string;
  class?: string;
}
const { number, class: className } = Astro.props;
---
<a class:list={['phone-number', className]} href="#" data-phone={encodePhone(number)}>{phoneHint(number, SITE.locale)}</a>

<script>
  // Put the number back on the client; it is not in the served HTML.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a.phone-number[data-phone]')) {
    try {
      const number = atob(a.dataset.phone!).split('').reverse().join('');
      a.href = `tel:${number.replace(/ /g, '')}`;
      a.textContent = number;
      a.removeAttribute('data-phone');
    } catch {
      /* leave the no-JS hint in place */
    }
  }
</script>
