---
// One mark per answer, drawn at build time as inline SVG: a filled circle for an answer
// that named the site, a hollow circle for one that did not, a cross for a call that
// failed. Marks and not percentages: a cell holds at most six answers, and "100%" of one
// answer says little. The three look different in shape as well as colour. The legend
// below the chart uses the same shapes. tests/a11y.spec.ts counts the marks and compares
// them with the published CSV, so keep the data-* attributes.
type Counts = { named: number; unnamed: number; failed: number };
// A string where the assistant is not asked in that mode: shown as words instead of marks.
type Cell = Counts | string;
interface Props {
  /** Unique on the page: names the ids that the SVG's title and description use. */
  id: string;
  rows: readonly { engine: string; assistant: string; withSearch: Cell; withoutSearch: Cell }[];
  title: string;
  desc: string;
}
const { id, rows, title, desc } = Astro.props;

// The widths leave room for a font about a fifth wider than the one measured (the longest
// label, "Google AI Overview", takes 135 units here): tests/a11y.spec.ts stresses them.
const W = 438;
const labelX = 6;
const headY = 16;
const firstY = 64;
const rowH = 34;
const pitch = 17;
const radius = 6;
const H = firstY + (rows.length - 1) * rowH + rowH / 2 + 4;
const columns = [
  { mode: 'with_search', heading: ['With', 'web search'], x: 182, cell: (r: (typeof rows)[number]) => r.withSearch },
  { mode: 'without_search', heading: ['Without', 'web search'], x: 295, cell: (r: (typeof rows)[number]) => r.withoutSearch },
] as const;

type Kind = 'named' | 'unnamed' | 'failed';
const kinds = (c: Counts) => (['named', 'unnamed', 'failed'] as const).flatMap((k) => Array<Kind>(c[k]).fill(k));
const cross = (cx: number, cy: number) => `M${cx - 5},${cy - 5}L${cx + 5},${cy + 5}M${cx - 5},${cy + 5}L${cx + 5},${cy - 5}`;
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`} data-chart={id}>
  <title id={`${id}-title`}>{title}</title>
  <desc id={`${id}-desc`}>{desc}</desc>
  {columns.map((col) => col.heading.map((line, i) => <text class="head" x={col.x} y={headY + i * 19}>{line}</text>))}
  {rows.map((r, i) => {
    const cy = firstY + i * rowH;
    return (
      <>
        {i > 0 && <line class="rule" x1="0" x2={W} y1={cy - rowH / 2} y2={cy - rowH / 2} />}
        <text class="label" x={labelX} y={cy} dy="0.35em">{r.assistant}</text>
        {columns.map((col) => {
          const cell = col.cell(r);
          return (
            <g data-engine={r.engine} data-mode={col.mode}>
              {typeof cell === 'string' ? (
                <text class="none" x={col.x} y={cy} dy="0.35em">{cell}</text>
              ) : (
                kinds(cell).map((kind, k) => {
                  const cx = col.x + radius + k * pitch;
                  return kind === 'failed'
                    ? <path class="failed" d={cross(cx, cy)} data-mark={kind} />
                    : <circle class={kind} cx={cx} cy={cy} r={kind === 'named' ? radius : radius - 1} data-mark={kind} />;
                })
              )}
            </g>
          );
        })}
      </>
    );
  })}
</svg>
<ul class="legend" role="list">
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><circle class="named" r={radius} /></svg>
    Named the site
  </li>
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><circle class="unnamed" r={radius - 1} /></svg>
    Answered, did not name it
  </li>
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><path class="failed" d={cross(0, 0)} /></svg>
    Call failed
  </li>
</ul>

<style>
  svg[data-chart] { display: block; width: 100%; height: auto; }
  text { font-family: var(--font); font-size: 15px; fill: var(--muted); }
  text.label { fill: var(--ink); }
  text.head { font-weight: 600; }
  .rule { stroke: var(--line); stroke-width: 1; }
  .named { fill: var(--accent); }
  .unnamed { fill: none; stroke: var(--muted); stroke-width: 2; }
  .failed { fill: none; stroke: var(--muted); stroke-width: 2.2; stroke-linecap: round; }

  .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; margin: 0.8rem 0 0; padding: 0; list-style: none; font-size: 0.9rem; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .legend svg { flex: none; }
</style>
