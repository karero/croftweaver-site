---
// One mark per call to an assistant, drawn at build time as inline SVG: a filled circle for an
// answer that named the site, a hollow circle for one that did not, a dash for a call that
// failed and gave no answer. Marks and not percentages: a cell holds at most six calls, and
// "100%" of one answer says little. The three differ in shape as well as colour, and a failed
// call is a neutral dash and not a cross, because it says nothing against the site. The legend
// below the chart repeats the shapes for sighted readers; the SVG's own description says the
// same for everyone else. tests/a11y.spec.ts counts the marks, compares them with the
// published CSV and checks where they sit, so keep the data-* attributes. The layout is
// tested in a wide font (Verdana, or DejaVu Sans on Linux). At 17 px the longest row label,
// "Google AI Overview", takes 149 units in the system font of macOS and 169 in Verdana; the
// longest word cell, "Always searches", 126 and 140; a semibold heading line, "web search",
// 91 and 109.
type Counts = { named: number; unnamed: number; failed: number };
// A string where the assistant is not asked in that mode: shown as words instead of marks.
type Cell = Counts | string;
interface Props {
  /** Unique on the page: names the ids that the SVG's title and description use. */
  id: string;
  rows: readonly { engine: string; assistant: string; withSearch: Cell; withoutSearch: Cell }[];
  title: string;
  desc: string;
}
const { id, rows, title, desc } = Astro.props;

const W = 460;
const labelX = 6;
const headY = 18;
const headGap = 21;
const firstY = 70;
const rowH = 34;
const pitch = 17;
const radius = 6;
const H = firstY + (rows.length - 1) * rowH + rowH / 2 + 4;
const columns = [
  { mode: 'with_search', heading: ['With', 'web search'], x: 188, cell: (r: (typeof rows)[number]) => r.withSearch },
  { mode: 'without_search', heading: ['Without', 'web search'], x: 305, cell: (r: (typeof rows)[number]) => r.withoutSearch },
] as const;

// A cell has room for the marks that fit between its column and the next one: seven. The
// data has at most six, for three calls on each of two questions.
const MAX_MARKS = Math.floor((columns[1].x - columns[0].x - 2 * radius) / pitch) + 1;
for (const r of rows) {
  for (const cell of [r.withSearch, r.withoutSearch]) {
    const marks = typeof cell === 'string' ? 0 : cell.named + cell.unnamed + cell.failed;
    if (marks > MAX_MARKS) throw new Error(`AiCheckChart "${id}": ${r.assistant} has ${marks} marks in one cell and the layout has room for ${MAX_MARKS}. Widen the columns first.`);
  }
}

type Kind = 'named' | 'unnamed' | 'failed';
const kinds = (c: Counts) => (['named', 'unnamed', 'failed'] as const).flatMap((k) => Array<Kind>(c[k]).fill(k));
const dash = (cx: number, cy: number) => `M${cx - 4.5},${cy}L${cx + 4.5},${cy}`;
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`} data-chart={id}>
  <title id={`${id}-title`}>{title}</title>
  <desc id={`${id}-desc`}>{desc}</desc>
  {columns.map((col) => col.heading.map((line, i) => <text class="head" x={col.x} y={headY + i * headGap}>{line}</text>))}
  {rows.map((r, i) => {
    const cy = firstY + i * rowH;
    return (
      <>
        {i > 0 && <line class="rule" x1="0" x2={W} y1={cy - rowH / 2} y2={cy - rowH / 2} />}
        <text class="label" x={labelX} y={cy} dy="0.35em" data-engine={r.engine}>{r.assistant}</text>
        {columns.map((col) => {
          const cell = col.cell(r);
          return (
            <g data-engine={r.engine} data-mode={col.mode}>
              {typeof cell === 'string' ? (
                <text class="none" x={col.x} y={cy} dy="0.35em">{cell}</text>
              ) : (
                kinds(cell).map((kind, k) => {
                  const cx = col.x + radius + k * pitch;
                  return kind === 'failed'
                    ? <path class="failed" d={dash(cx, cy)} data-mark={kind} />
                    : <circle class={kind} cx={cx} cy={cy} r={kind === 'named' ? radius : radius - 1} data-mark={kind} />;
                })
              )}
            </g>
          );
        })}
      </>
    );
  })}
</svg>
<ul class="legend" aria-hidden="true">
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><circle class="named" r={radius} /></svg>
    Named the site
  </li>
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><circle class="unnamed" r={radius - 1} /></svg>
    Answered, did not name it
  </li>
  <li>
    <svg viewBox="-9 -9 18 18" width="18" height="18" aria-hidden="true" focusable="false"><path class="failed" d={dash(0, 0)} /></svg>
    Call failed
  </li>
</ul>

<style>
  svg[data-chart] { display: block; width: 100%; height: auto; }
  text { font-family: var(--font); font-size: 17px; fill: var(--muted); }
  text.label { fill: var(--ink); }
  text.head { font-weight: 600; }
  .rule { stroke: var(--line); stroke-width: 1; }
  .named { fill: var(--accent); }
  .unnamed { fill: none; stroke: var(--muted); stroke-width: 2; }
  .failed { fill: none; stroke: var(--muted); stroke-width: 2.4; stroke-linecap: round; }

  .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; margin: 0.8rem 0 0; padding: 0; list-style: none; font-size: 0.9rem; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .legend svg { flex: none; }
</style>
