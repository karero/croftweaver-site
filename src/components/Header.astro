---
// Site header: the horizontal logo lockup (BRAND.md), and the main navigation from
// NAV in src/config.ts. A language switcher mounts here later.
import { SITE, NAV } from '../config';
import lockupSource from '../assets/brand/lockup-horizontal-dark-ink.svg?raw';

// Inline the lockup so it follows the site theme (light, dark, or the visitor's toggle):
// every fill and stroke (except none) becomes currentColor, set by .brand below. The embedded
// content credentials stay in the source file; the inlined copy drops them, and its
// fixed size, so CSS sizes it (the viewBox keeps the proportions).
const lockup = lockupSource
  .replace(/<metadata>[\s\S]*?<\/metadata>/, '')
  .replace(/ xmlns:c2pa="[^"]*"/, '')
  .replace(/ width="[\d.]+" height="[\d.]+"/, '')
  .replace(/(fill|stroke)="(?!none")[^"]*"/g, '$1="currentColor"');
// What the lines above cannot theme (CSS, inline styles, gradients) or should not ship
// (credentials) would leave a fixed colour, invisible on one theme, or kilobytes on every
// page. A re-exported logo with any of it stops the build instead.
if (/<metadata|c2pa|<style|style="|stop-color|Gradient/.test(lockup) || !lockup.includes('currentColor')) {
  throw new Error('Header: the logo lockup could not be made theme-aware; check src/assets/brand/lockup-horizontal-dark-ink.svg');
}

// Build-time pathnames end in .html (build.format: 'file'); compare the clean form.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '') || '/';
// Only a page link can be the current page; an anchor on the home page is not one.
const isCurrent = (href: string) => !href.includes('#') && href === path;
---
<header class="site-header">
  <a class="brand" href="/" aria-label={SITE.name}><Fragment set:html={lockup} /></a>
  <nav aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
      <li><a class="repo" href={SITE.repo}>GitHub</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    max-width: var(--maxw); margin-inline: auto; padding: 0.75rem 1.25rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  /* 44px minimum tap target on every header link (BRAND.md, mobile rules). */
  .brand, nav a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .brand { color: var(--heading); }
  .brand :global(svg) { display: block; height: 1.75rem; width: auto; }
  nav ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.4rem;
  }
  nav a { color: var(--ink); }
  nav a:hover { color: var(--link); text-decoration: underline; }
  nav a[aria-current='page'] { color: var(--link); font-weight: 600; }
  .repo {
    padding: 0 0.9rem; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); font-weight: 600;
  }
</style>
