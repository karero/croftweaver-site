---
// Site header: the horizontal logo lockup (BRAND.md), the claim under it, and the main
// navigation from NAV in src/config.ts. A language switcher mounts here later.
//
// An item of NAV is a link, or a group: a button that opens a list of links under it. The
// lists are in the page at load, hidden by CSS and never made on a click, so the dead-link
// suite reads their links and they stay reachable without JavaScript.
//
// On a phone the navigation folds behind a "Menu" button. The button is switched on by a
// script, so without JavaScript the links simply stay visible, as they were before. The
// first script below runs before the list is drawn, so nothing flashes open and shut.
// Where a group shows as a button (JavaScript on, the navigation not folded) and where it
// shows as a plain name above its links (a phone, or no JavaScript) is the style block's
// job: see "The fold" there.
import { SITE, NAV, isNavGroup } from '../config';
// The theme-ready lockup: its ink is currentColor, set by .brand below, so it follows the
// light and dark theme and the visitor's toggle. How it is made from the design files:
// BRAND.md, Logo. tests/a11y.spec.ts checks it renders in the theme's colour.
import lockup from '../assets/brand/lockup-horizontal-theme.svg?raw';

// Build-time pathnames end in .html (build.format: 'file'); compare the clean form.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '') || '/';
// Only a page link can be the current page; an anchor on the home page is not one.
const isCurrent = (href: string) => !href.includes('#') && href === path;
---
<header class="site-header">
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="identity">
    <a class="brand" href="/" aria-label={SITE.name}><Fragment set:html={lockup} /></a>
    <p class="claim">{SITE.claim}</p>
  </div>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
  <nav id="main-nav" aria-label="Main">
    <ul>
      {NAV.map((item, i) => isNavGroup(item) ? (
        <li class="group">
          <button
            class="group-button" type="button" aria-expanded="false" aria-controls={`nav-group-${i}`}
            aria-current={item.items.some((link) => isCurrent(link.href)) ? 'true' : undefined}
          >{item.label}<span class="chevron" aria-hidden="true">▾</span></button>
          <span class="group-label">{item.label}</span>
          <ul class="group-list" id={`nav-group-${i}`}>
            {item.items.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
      <li><a class="repo" href={SITE.repo}>Get it on GitHub</a></li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var button = document.querySelector('.site-header .menu-button');
    var nav = document.getElementById('main-nav');
    if (!button || !nav) return;
    function set(open) { button.setAttribute('aria-expanded', open ? 'true' : 'false'); }
    button.addEventListener('click', function () { set(button.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || button.getAttribute('aria-expanded') !== 'true') return;
      // Focus on a link that is about to be hidden would be lost: hand it to the button.
      // Focus elsewhere on the page stays where the visitor put it.
      var inMenu = nav.contains(document.activeElement);
      set(false);
      if (inMenu) button.focus();
    });

    // Groups. A button opens the list under it; one list is open at a time. The buttons only show
    // where the style block says so (JavaScript on, the navigation not folded); elsewhere the lists
    // are always shown and nothing here can be reached.
    var groups = nav.querySelectorAll('.group');
    function groupButton(group) { return group.querySelector('.group-button'); }
    function isOpen(group) { return groupButton(group).getAttribute('aria-expanded') === 'true'; }
    function setGroup(group, open) { groupButton(group).setAttribute('aria-expanded', open ? 'true' : 'false'); }
    Array.prototype.forEach.call(groups, function (group) {
      groupButton(group).addEventListener('click', function () {
        var opening = !isOpen(group);
        Array.prototype.forEach.call(groups, function (other) { if (other !== group) setGroup(other, false); });
        setGroup(group, opening);
      });
      // Focus moving to something outside the group closes it. A null target does not: Safari and
      // Firefox on macOS do not focus a link on click, and closing then could remove the list before
      // the click lands. (Tab out of the page leaves it open; Escape or a click elsewhere closes it.)
      group.addEventListener('focusout', function (e) {
        if (e.relatedTarget && !group.contains(e.relatedTarget)) setGroup(group, false);
      });
    });
    document.addEventListener('click', function (e) {
      Array.prototype.forEach.call(groups, function (group) {
        if (isOpen(group) && !group.contains(e.target)) setGroup(group, false);
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      Array.prototype.forEach.call(groups, function (group) {
        if (!isOpen(group)) return;
        // Focus on a link that is about to be hidden would be lost: hand it to the button.
        var inGroup = group.contains(document.activeElement);
        setGroup(group, false);
        if (inGroup) groupButton(group).focus();
      });
    });
  })();
</script>

<style>
  .site-header {
    max-width: var(--maxw); margin-inline: auto; padding: 0.75rem 1.25rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  /* 44px minimum tap target on every header link (BRAND.md, mobile rules). */
  .brand, nav a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .brand { color: var(--heading); }
  .brand :global(svg) { display: block; height: 1.75rem; width: auto; }
  .claim { margin: -0.15rem 0 0.25rem; font-size: 0.85rem; line-height: 1.3; color: var(--muted); }
  /* Shown only on a phone, and only once the script has run (html.js). */
  .menu-button {
    display: none; min-height: 44px; align-items: center; padding: 0 0.9rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer;
  }
  nav > ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.4rem;
  }
  nav a { color: var(--ink); }
  nav a:hover { color: var(--link); text-decoration: underline; }
  nav a[aria-current='page'] { color: var(--link); font-weight: 600; }
  .repo {
    padding: 0 0.9rem; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); font-weight: 600;
  }

  /* A group, as the baseline (no JavaScript, or a phone): its name as a plain label with its links
     under or beside it, all shown, and no button. */
  .group { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; }
  .group-button {
    display: none; min-height: 44px; align-items: center; gap: 0.3rem; padding: 0 0.1rem;
    border: 0; background: none; color: var(--ink); font: inherit; cursor: pointer;
  }
  .group-label { font-weight: 600; color: var(--muted); }
  .group-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .group-button:hover { color: var(--link); text-decoration: underline; }
  .group-button[aria-current='true'] { color: var(--link); font-weight: 600; }
  .chevron { font-size: 0.8em; }

  /* The fold: below 47.99rem the navigation folds behind the Menu button; from 48rem it stands in the
     header. Two media queries use the number, below and further down: keep them equal. */

  /* Wide, with JavaScript: a group is a button that opens its list as a panel under it. */
  @media (min-width: 48rem) {
    :global(html.js) .group { display: block; position: relative; }
    :global(html.js) .group-button { display: inline-flex; }
    :global(html.js) .group-label { display: none; }
    :global(html.js) .group-list {
      display: none; position: absolute; top: 100%; left: 0; z-index: 20;
      flex-direction: column; flex-wrap: nowrap; gap: 0; min-width: 12rem; max-width: calc(100vw - 2.5rem);
      padding: 0.35rem; background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius); box-shadow: var(--shadow);
    }
    :global(html.js) .group-list a { width: 100%; padding: 0 0.75rem; box-sizing: border-box; white-space: nowrap; }
    :global(html.js) .group-button[aria-expanded='true'] ~ .group-list { display: flex; }
  }
  /* Phones: the list folds behind the button and opens as one column under the logo. */
  @media (max-width: 47.99rem) {
    /* The logo is a little smaller here, so logo and button share the first row down to 320px. */
    .site-header { column-gap: 0.75rem; }
    .brand :global(svg) { height: 1.5rem; }
    :global(html.js) .identity { flex: 1 1 0; min-width: 0; }
    :global(html.js) .menu-button { display: inline-flex; }
    :global(html.js) nav { flex-basis: 100%; }
    :global(html.js) .menu-button[aria-expanded='false'] + nav { display: none; }
    :global(html.js) nav > ul { flex-direction: column; align-items: stretch; gap: 0; padding-bottom: 0.5rem; }
    :global(html.js) nav li a { width: 100%; }
    :global(html.js) nav li .repo { justify-content: center; margin-top: 0.5rem; }
    /* A group on a phone: its name, then its links in a column. */
    :global(html.js) .group { display: block; padding-top: 0.5rem; }
    :global(html.js) .group-label { display: block; }
    :global(html.js) .group-list { display: block; padding-left: 0.75rem; }
  }
</style>
