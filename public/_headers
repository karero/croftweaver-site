# Cloudflare headers (Pages and Workers static assets): the security headers for every page, then a cache rule for /brand/ (below).
# CSP allows the inlined stylesheet
# (astro.config `inlineStylesheets: 'always'`) via style-src 'unsafe-inline' and
# the inline theme script, the header's two menu scripts and the analytics stub; the analytics host is listed in script-src
# and connect-src (tests/check_analytics_gate.sh checks both against src/config.ts).
# Widen script-src/connect-src only as needed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://analytics.m-squad.com; connect-src 'self' https://analytics.m-squad.com; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Preview and version links (workers.dev) are outside the zone, so its NEL setting cannot reach
# them; this NEL policy of max_age 0 withdraws any policy, and Cloudflare then adds neither its
# own NEL nor Report-To there (the toolkit starter's rule). Pages ignores it.
https://:version.:sub.workers.dev/*
  NEL: {"max_age":0}

# Plain-text files: Pages sends charset=utf-8 with them, a Worker's static assets send none, and
# llms.txt has non-ASCII text. One rule per file, outside /*: Cloudflare joins the values of a
# header that two matching rules set. tests/navigation.spec.ts checks every .txt has its rule.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/build.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Files under /brand/ keep their names when they change, and the Markdown snippets on /partner-assets
# hotlink the badges from partners' READMEs: cache them for a day, never mark them immutable. Pages'
# default is "public, max-age=0, must-revalidate", which makes a cache ask the server before it reuses
# a file. Pages joins the values of one header set by several rules with a comma, so no other rule may
# set Cache-Control for these files; tests/navigation.spec.ts reads the result.
/brand/*
  Cache-Control: public, max-age=86400
